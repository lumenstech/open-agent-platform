# Langflow runtime
LANGFLOW_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
LANGFLOW_SECRET_KEY=replace-with-a-long-random-secret
LANGFLOW_SUPERUSER=langflow-admin
LANGFLOW_SUPERUSER_PASSWORD=replace-with-a-strong-password

# Control-plane proxy
LANGFLOW_BASE_URL=http://127.0.0.1:7860
LANGFLOW_API_KEY=
LANGFLOW_SHARED_RUNTIME_ENABLED=false
LANGFLOW_SHARED_RUNTIME_TOKEN=replace-with-a-long-random-server-to-server-token

# Read-only product tool gateway. These are full product API/MCP adapter URLs;
# leave blank until the corresponding product endpoint is ready.
LANGFLOW_TOOL_GATEWAY_TOKEN=replace-with-a-long-random-tool-gateway-token
LANGFLOW_TOOL_COMP_CRM_LOOKUP_COMPANY_URL=
LANGFLOW_TOOL_COMP_CRM_TOKEN=
LANGFLOW_TOOL_GUYANA_SEARCH_OPPORTUNITIES_URL=
LANGFLOW_TOOL_GUYANA_ELECTRICAL_PROFILE_URL=
LANGFLOW_TOOL_GUYANA_TOKEN=
LANGFLOW_TOOL_LABSNET_ROUTE_ORDER_URL=
LANGFLOW_TOOL_LABSNET_TOKEN=
LANGFLOW_TOOL_PROPERTYGY_SEARCH_LISTINGS_URL=
LANGFLOW_TOOL_PROPERTYGY_TOKEN=
LANGFLOW_TOOL_RECEPTIONOS_LOOKUP_CONTEXT_URL=
LANGFLOW_TOOL_RECEPTIONOS_TOKEN=
LANGFLOW_TOOL_SHARED_RETRIEVE_DOCUMENTS_URL=
LANGFLOW_TOOL_SHARED_RETRIEVE_DOCUMENTS_TOKEN=

# Flow IDs are intentionally configured outside source control.
LANGFLOW_FLOW_BIDAGENT_OPPORTUNITY_QUALIFIER=
LANGFLOW_FLOW_BIDAGENT_SOLICITATION_READER=
LANGFLOW_FLOW_BIDAGENT_PROPOSAL_AGENT=
LANGFLOW_FLOW_COMP_CRM_COMPANY_RESEARCH=
LANGFLOW_FLOW_COMP_CRM_LEAD_ENRICHMENT=
LANGFLOW_FLOW_COMP_CRM_OPPORTUNITY_SCORING=
LANGFLOW_FLOW_GUYANA_OPPORTUNITY_SCOUT=
LANGFLOW_FLOW_GUYANA_ELECTRICAL_FIT_QUALIFIER=
LANGFLOW_FLOW_LABSNET_TEST_CLASSIFIER=
LANGFLOW_FLOW_LABSNET_LAB_ROUTER=
LANGFLOW_FLOW_LABSNET_RFQ_GENERATOR=
LANGFLOW_FLOW_PROPERTYGY_LISTING_ENRICHMENT=
LANGFLOW_FLOW_PROPERTYGY_BUYER_AGENT=
LANGFLOW_FLOW_RECEPTIONOS_CALL_REASONING=
LANGFLOW_FLOW_RECEPTIONOS_TOOL_ROUTER=
